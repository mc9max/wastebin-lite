# ═══════════════════════════════════════════════════════════════════════════
# Wastebin Lite — Local run reference (podman/docker).
# On Railway these become template variables (see template-editor-raw.json);
# the two secrets auto-generate per install via ${{secret(N)}}.
# ═══════════════════════════════════════════════════════════════════════════

# --- Required ──────────────────────────────────────────────────────────────
# Public base URL used for the paste links shown in the UI / API responses.
# Railway auto-substitutes RAILWAY_PUBLIC_DOMAIN.
WASTEBIN_BASE_URL=https://paste.example.com

# MUST be >= 64 bytes — the server refuses to boot with a shorter key.
# Generate:  head -c 64 /dev/urandom | base64 | head -c 64
WASTEBIN_SIGNING_KEY=

# Must be identical on every (re)start or encrypted pastes become unreadable.
# Generate:  head -c 16 /dev/urandom | base64 | head -c 16
WASTEBIN_PASSWORD_SALT=

# --- Optional (defaults shown) ─────────────────────────────────────────────
# Site title shown in the browser tab.
WASTEBIN_TITLE=Wastebin Lite

# Default UI theme: ayu | base16ocean | catppuccin | coldark | gruvbox |
# monokai | onehalf | rosepine | solarized
WASTEBIN_THEME=catppuccin

# Max paste body size in bytes (default 1 MiB).
WASTEBIN_MAX_BODY_SIZE=1048576

# Expiry options offered in the UI (comma-separated; 0 = no expiry).
WASTEBIN_PASTE_EXPIRATIONS=0,10m,1h,1d,1M,1y

# Where the SQLite DB lives (mounted volume on Railway).
WASTEBIN_DATABASE_PATH=/data/state.db

# Host:port. 0.0.0.0:8088 is baked into the Dockerfile; override to re-bind.
WASTEBIN_ADDRESS_PORT=0.0.0.0:8088
